  "scripts": {
    "deploy-root-client": "nx build nfc-root-client --prod && nx deploy nfc-root-client",
    "deploy-player": "nx build nfc-player --prod && nx deploy nfc-player",
    "deploy-agent-client": "nx build nfc-agent-client --prod && nx deploy nfc-agent-client",
    "deploy-company-client": "nx build nfc-company-client --prod && nx deploy nfc-company-client",
    "deploy-api": "bun build --target=bun ./apps/nfc-api/src/main.ts --outdir ./dist/apps/nfc-api && nx deploy nfc-api",
    "deploy-version": "npm run deploy-player && npm run deploy-agent-client && npm run deploy-api && npm run deploy-company-client && npm run deploy-root-client && npm run cap-sync",
    "cap-ios": "nx run nfc-agent-client:cap:open-ios",
    "cap-android": "nx run nfc-agent-client:cap:open-android",
    "cap-sync": "nx build nfc-agent-client --prod && nx run nfc-agent-client:cap:sync"
  },
