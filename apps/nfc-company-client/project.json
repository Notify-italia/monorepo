{
  "name": "nfc-company-client",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "notify",
  "sourceRoot": "apps/nfc-company-client/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular-devkit/build-angular:browser",
      "outputs": [
        "{options.outputPath}"
      ],
      "allowedCommonJsDependencies": [
        "qrcode",
        "file-saver",
        "compressorjs",
        "apexcharts",
        "mongoose",
        "dropzone"
      ],
      "options": {
        "outputPath": "dist/apps/nfc-company-client",
        "index": "apps/nfc-company-client/src/index.html",
        "main": "apps/nfc-company-client/src/main.ts",
        "polyfills": [
          "zone.js"
        ],
        "tsConfig": "apps/nfc-company-client/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          "apps/nfc-company-client/src/favicon.ico",
          "apps/nfc-company-client/src/assets",
          {
            "input": "libs/utils/assets",
            "glob": "*",
            "output": "assets"
          }
        ],
        "styles": [
          "apps/nfc-company-client/src/styles.scss",
          "libs/utils/src/lib/global.scss"
        ],
        "scripts": [
          "node_modules/apexcharts/dist/apexcharts.min.js"
        ]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "100mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4mb",
              "maximumError": "400mb"
            }
          ],
          "outputHashing": "all",
          "fileReplacements": [
            {
              "replace": "apps/nfc-company-client/src/environments/environment.ts",
              "with": "apps/nfc-company-client/src/environments/environment.prod.ts"
            }
          ]
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        },
        "ptc": {
          "outputHashing": "all",
          "fileReplacements": [
            {
              "replace": "apps/nfc-company-client/src/environments/environment.ts",
              "with": "apps/nfc-company-client/src/environments/environment.ptc.ts"
            }
          ]
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@angular-devkit/build-angular:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "nfc-company-client:build:production"
        },
        "development": {
          "buildTarget": "nfc-company-client:build:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "buildTarget": "nfc-company-client:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": [
        "{options.outputFile}"
      ]
    },
    "deploy": {
      "executor": "nx:run-commands",
      "outputs": [],
      "options": {
        "command": "cp ./apps/nfc-company-client/Dockerfile ./dist/apps/nfc-company-client && cp ./apps/nfc-company-client/captain-definition ./dist/apps/nfc-company-client && tar --strip-components=4 -cvf ./deploy.tar --exclude='*.map' ./dist/apps/nfc-company-client/* && caprover deploy -t ./deploy.tar -n notify -a company-client && rm ./deploy.tar"
      }
    }
  }
}