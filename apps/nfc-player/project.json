{
  "name": "nfc-player",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "notify",
  "sourceRoot": "apps/nfc-player/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular-devkit/build-angular:browser",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/apps/nfc-player",
        "index": "apps/nfc-player/src/index.html",
        "main": "apps/nfc-player/src/main.ts",
        "polyfills": [
          "zone.js"
        ],
        "tsConfig": "apps/nfc-player/tsconfig.app.json",
        "assets": [
          "apps/nfc-player/src/favicon.ico",
          "apps/nfc-player/src/assets",
          {
            "input": "libs/utils/assets",
            "glob": "*",
            "output": "assets"
          }
        ],
        "styles": [
          "apps/nfc-player/src/styles.scss",
          "node_modules/animate.css/animate.min.css"
        ],
        "scripts": []
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4mb",
              "maximumError": "400mb"
            }
          ],
          "outputHashing": "all",
          "fileReplacements": [
            {
              "replace": "apps/nfc-player/src/environments/environment.ts",
              "with": "apps/nfc-player/src/environments/environment.prod.ts"
            }
          ]
        },
        "development": {
          "buildOptimizer": false,
          "optimization": false,
          "vendorChunk": true,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@angular-devkit/build-angular:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "nfc-player:build:production"
        },
        "development": {
          "buildTarget": "nfc-player:build:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "buildTarget": "nfc-player:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": [
        "{options.outputFile}"
      ],
      "options": {
        "lintFilePatterns": [
          "apps/nfc-player/**/*.ts",
          "apps/nfc-player/**/*.html"
        ]
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "outputs": [],
      "options": {
        "command": "cp ./apps/nfc-player/Dockerfile ./dist/apps/nfc-player && cp ./apps/nfc-player/captain-definition ./dist/apps/nfc-player && tar --strip-components=4 -cvf ./deploy.tar --exclude='*.map' ./dist/apps/nfc-player/* && caprover deploy -t ./deploy.tar -n notify -a profiles-player && rm ./deploy.tar"
      }
    }
  }
}