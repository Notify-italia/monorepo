{
  "name": "nfc-api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/nfc-api/src",
  "targets": {
    "build": {
      "executor": "@nx-bun/nx:build",
      "outputs": ["{options.outputPath}"],
      "options": {
        "entrypoints": ["apps/nfc-api/src/main.ts"],
        "outputPath": "dist/nfc-api",
        "tsConfig": "apps/nfc-api/tsconfig.app.json",
        "smol": true,
        "bun": true,
        "minify": true,
        "complie": true,
        "target": "bun"
      }
    },
    "serve": {
      "executor": "@nx-bun/nx:run",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "nfc-api:build",
        "tsConfig": "apps/nfc-api/tsconfig.app.json",
        "watch": true,
        "hot": true,
        "bun": true,
        "smol": false
      }
    },
    "test": {
      "executor": "@nx-bun/nx:test",
      "options": {
        "smol": false,
        "bail": true,
        "tsConfig": "apps/nfc-api/tsconfig.json",
        "bun": true
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "outputs": [],
      "options": {
        "command": "cp ./apps/nfc-api/Dockerfile ./dist/apps/nfc-api && cp ./apps/nfc-api/captain-definition ./dist/apps/nfc-api && tar --strip-components=4 -cvf ./deploy.tar --exclude='*.map' ./dist/apps/nfc-api/* && caprover deploy -t ./deploy.tar -n notify -a notify-api && rm ./deploy.tar"
      }
    }
  }
}
