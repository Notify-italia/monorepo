{
  "name": "api-shared",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/api-shared/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx-bun/nx:build",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "entrypoints": [
          "libs/api-shared/src/index.ts"
        ],
        "outputPath": "dist/api-shared",
        "tsConfig": "libs/api-shared/tsconfig.lib.json",
        "smol": false,
        "bun": true
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": [
          "libs/api-shared/**/*.ts",
          "libs/api-shared/package.json"
        ]
      }
    }
  }
}