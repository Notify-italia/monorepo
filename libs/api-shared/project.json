{
  "name": "api-shared",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/nfc-api-services/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx-bun/nx:build",
      "outputs": ["{options.outputPath}"],
      "options": {
        "entrypoints": ["libs/nfc-api-services/src/index.ts"],
        "outputPath": "dist/nfc-api-services",
        "tsConfig": "libs/nfc-api-services/tsconfig.lib.json",
        "smol": false,
        "bun": true
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": [
          "libs/nfc-api-services/**/*.ts",
          "libs/nfc-api-services/package.json"
        ]
      }
    }
  }
}
