{
  "name": "ngx-shared",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/ngx-shared/src",
  "prefix": "notify",
  "tags": [],
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "@nx/angular:ng-packagr-lite",
      "outputs": [
        "{workspaceRoot}/dist/{projectRoot}"
      ],
      "options": {
        "project": "libs/ngx-shared/ng-package.json",
        "tailwindConfig": "libs/ngx-shared/tailwind.config.js"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/ngx-shared/tsconfig.lib.prod.json"
        },
        "development": {
          "tsConfig": "libs/ngx-shared/tsconfig.lib.json"
        }
      },
      "defaultConfiguration": "production"
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": [
        "{options.outputFile}"
      ]
    }
  }
}